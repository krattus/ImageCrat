// Template: windows/build.ps1 fills in @NAME@, @EXE@, @DESCRIPTION@, @VERSION@, @VERSIONCOMMA@ and @MANIFEST@ and
// compiles one .res per executable (icon, manifest, version information). Plain numbers instead of winres.h so that
// rc.exe needs no include path.
1 ICON "@ICON@"
1 24 "@MANIFEST@"

1 VERSIONINFO
 FILEVERSION @VERSIONCOMMA@
 PRODUCTVERSION @VERSIONCOMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "krattus"
            VALUE "FileDescription", "@DESCRIPTION@"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "@NAME@"
            VALUE "LegalCopyright", "Copyright 2026 krattus. PolyForm Noncommercial 1.0.0"
            VALUE "OriginalFilename", "@EXE@"
            VALUE "ProductName", "ImageCrat Preview"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
