<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for the Developer ID build (scripts/release.sh). Keep this list minimal.
     allow-jit: JavaScriptCore (Scripts, plugin panels) compiles scripts at runtime; without it they run interpreted. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
</dict>
</plist>
